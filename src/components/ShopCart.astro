---
// ShopCart.astro — floating cart button and slide-out cart drawer.
// Checkout happens on the dedicated /shop/checkout page.
// Exposes window.pxpCart = { add, open } so product cards & modals can hook in.
export interface Props {
  catalog: {
    id: string; title: string; price: number; image: string; remaining: number; stockMode?: string;
  }[];
  flatShipping: number;           // dollars
  freeShippingOver: number | null; // dollars, or null
}
const { catalog, flatShipping, freeShippingOver } = Astro.props;
---

<!-- Floating cart button -->
<button class="cart-fab" id="cartFab" aria-label="Open cart">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
  </svg>
  <span class="cart-fab__count empty" id="cartCount">0</span>
</button>

<!-- Cart drawer -->
<div class="cart-overlay" id="cartOverlay"></div>
<aside class="cart-drawer" id="cartDrawer" aria-label="Shopping cart">
  <div class="cart-drawer__head">
    <div class="cart-drawer__title">Your Cart</div>
    <button class="cart-drawer__close" id="cartClose" aria-label="Close cart">×</button>
  </div>
  <div class="cart-drawer__items" id="cartItems"></div>
  <div class="cart-drawer__foot" id="cartFoot" style="display:none;">
    <div class="cart-subtotal"><span>Subtotal</span><span id="cartSubtotal">$0</span></div>
    <div class="cart-ship-note" id="cartShipNote"></div>
    <a class="btn btn--primary btn--full" id="cartCheckout" href="/shop/checkout">Checkout</a>
    <span class="stripe-note" style="margin-top:10px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Secure checkout powered by Stripe
    </span>
  </div>
</aside>

<script define:vars={{ catalog, flatShipping, freeShippingOver }}>
const CART_KEY = 'pxp_cart';
const byId = Object.fromEntries(catalog.map(p => [p.id, p]));

// ── Cart state (localStorage) ────────────────────────────────────────────────
function loadCart() {
  try {
    const raw = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    // Drop items no longer in the catalog; clamp qty to remaining stock
    return raw
      .filter(i => byId[i.id] && byId[i.id].remaining > 0)
      .map(i => ({ id: i.id, qty: Math.min(Math.max(1, i.qty), byId[i.id].remaining) }));
  } catch { return []; }
}
let cart = loadCart();
function saveCart() { localStorage.setItem(CART_KEY, JSON.stringify(cart)); }

// ── DOM refs ─────────────────────────────────────────────────────────────────
const fab       = document.getElementById('cartFab');
const countEl   = document.getElementById('cartCount');
const overlay   = document.getElementById('cartOverlay');
const drawer    = document.getElementById('cartDrawer');
const itemsEl   = document.getElementById('cartItems');
const footEl    = document.getElementById('cartFoot');
const subEl     = document.getElementById('cartSubtotal');
const shipEl    = document.getElementById('cartShipNote');

const fmt = n => '$' + (Number.isInteger(n) ? n : n.toFixed(2));

// ── Render ───────────────────────────────────────────────────────────────────
function render() {
  const totalQty = cart.reduce((s, i) => s + i.qty, 0);
  countEl.textContent = String(totalQty);
  countEl.classList.toggle('empty', totalQty === 0);

  if (cart.length === 0) {
    itemsEl.innerHTML = `<div class="cart-drawer__empty">Your cart is empty.<br>Every piece is handmade — once it's gone, it's gone!</div>`;
    footEl.style.display = 'none';
    return;
  }

  itemsEl.innerHTML = cart.map(i => {
    const p = byId[i.id];
    return `
      <div class="cart-item" data-id="${p.id}">
        <img class="cart-item__img" src="${p.image}" alt="">
        <div class="cart-item__body">
          <div class="cart-item__title">${p.title}</div>
          <div class="cart-item__price">${fmt(p.price)}${i.qty > 1 ? ` × ${i.qty}` : ''}</div>
          <div class="cart-item__row">
            <div class="cart-qty">
              <button data-dec aria-label="Decrease quantity">−</button>
              <span>${i.qty}</span>
              <button data-inc aria-label="Increase quantity" ${i.qty >= p.remaining ? 'disabled' : ''}>+</button>
            </div>
            <button class="cart-item__remove" data-remove>Remove</button>
          </div>
        </div>
      </div>`;
  }).join('');

  const subtotal = cart.reduce((s, i) => s + byId[i.id].price * i.qty, 0);
  subEl.textContent = fmt(subtotal);
  const freeShip = freeShippingOver != null && subtotal >= freeShippingOver;
  shipEl.textContent = freeShip
    ? 'Free shipping on this order!'
    : `+ ${fmt(flatShipping)} flat-rate shipping — added at checkout.`;
  footEl.style.display = '';
}

// ── Drawer open/close ────────────────────────────────────────────────────────
function openDrawer()  { overlay.classList.add('open'); drawer.classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeDrawer() { overlay.classList.remove('open'); drawer.classList.remove('open'); document.body.style.overflow = ''; }

fab.addEventListener('click', openDrawer);
overlay.addEventListener('click', closeDrawer);
document.getElementById('cartClose').addEventListener('click', closeDrawer);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

// ── Cart mutations ───────────────────────────────────────────────────────────
function addToCart(id) {
  const p = byId[id];
  if (!p || p.remaining <= 0) return;
  const existing = cart.find(i => i.id === id);
  if (existing) {
    if (existing.qty >= p.remaining) return;
    existing.qty += 1;
  } else {
    cart.push({ id, qty: 1 });
  }
  saveCart(); render();
  fab.classList.remove('bump'); void fab.offsetWidth; fab.classList.add('bump');
}

itemsEl.addEventListener('click', e => {
  const row = e.target.closest('.cart-item');
  if (!row) return;
  const id = row.dataset.id;
  const item = cart.find(i => i.id === id);
  if (!item) return;
  if (e.target.closest('[data-inc]'))    { if (item.qty < byId[id].remaining) item.qty += 1; }
  if (e.target.closest('[data-dec]'))    { item.qty -= 1; if (item.qty <= 0) cart = cart.filter(i => i.id !== id); }
  if (e.target.closest('[data-remove]')) { cart = cart.filter(i => i.id !== id); }
  saveCart(); render();
});

// Add-to-cart buttons anywhere on the page
document.addEventListener('click', e => {
  const btn = e.target.closest('.btn-add-to-cart');
  if (!btn) return;
  addToCart(btn.dataset.productId);
  openDrawer();
});

// Restore body scroll before navigating to checkout
document.getElementById('cartCheckout').addEventListener('click', () => {
  document.body.style.overflow = '';
});

// Expose for the product detail modal
window.pxpCart = { add: addToCart, open: openDrawer };

render();
</script>
