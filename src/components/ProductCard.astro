---
import type { StockMode } from '../lib/shopStore';

export interface Props {
  id: string;
  title: string;
  description: string;
  price: number;
  imageSrc: string;
  images?: string[];
  category?: string | null;
  dimensions?: string | null;
  badge?: string | null;
  remaining: number;
  stockMode?: StockMode;
  index?: number;
}

const {
  id, title, description, price, imageSrc, images = [imageSrc],
  category = null, dimensions = null, badge = null,
  remaining, stockMode = 'limited', index = 0,
} = Astro.props;

const madeToOrder = stockMode === 'made_to_order';
const soldOut = !madeToOrder && remaining <= 0;
const displayBadge = badge || (!madeToOrder && !soldOut && remaining === 1 ? 'One of a Kind' : null);
const stockLabel = madeToOrder
  ? 'Made to order'
  : soldOut ? null
  : remaining === 1 ? 'Only 1 available'
  : remaining === 2 ? 'Only 2 left'
  : null;
---

<div
  class={`shop-card fade-in fade-in-delay-${(index % 3) + 1} ${soldOut ? 'shop-card--soldout' : ''}`}
  data-product-id={id}
  data-product-title={title}
  data-product-description={description}
  data-product-price={String(price)}
  data-product-image={imageSrc}
  data-product-images={JSON.stringify(images)}
  data-product-category={category ?? ''}
  data-product-dimensions={dimensions ?? ''}
  data-product-remaining={String(remaining)}
  data-product-stock-mode={stockMode}
>
  <div class="shop-card__frame btn-show-product" role="button" tabindex="0" aria-label={`View ${title}`}>
    <img src={imageSrc} alt={title} loading="lazy" />
    {displayBadge && !soldOut && <span class="shop-card__badge">{displayBadge}</span>}
    {soldOut ? (
      <span class="shop-card__soldout">Sold</span>
    ) : (
      <button class="shop-card__quick btn-add-to-cart" data-product-id={id} aria-label={`Add ${title} to cart`}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        Add to Cart
      </button>
    )}
  </div>
  <div class="shop-card__body">
    {category && <div class="shop-card__cat">{category}</div>}
    <h3 class="shop-card__name">{title}</h3>
    <div class="shop-card__price-row">
      <span class="shop-card__price">${price}</span>
      {soldOut && <span class="shop-card__stock shop-card__stock--sold">Sold</span>}
      {stockLabel && <span class="shop-card__stock">{stockLabel}</span>}
    </div>
  </div>
</div>
