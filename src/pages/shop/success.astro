---
export const prerender = false;
import Base from '../../layouts/Base.astro';
---
<Base title="Order Confirmed! — Piece x Piece" description="Your order is confirmed.">
  <style>
    .success-wrap {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 100px 24px 60px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(160deg, #f5f0ea 0%, #e8f4f3 60%, #d6eeec 100%);
    }

    .tile {
      position: absolute;
      border-radius: 4px;
      opacity: 0.18;
      animation: float linear infinite;
    }
    .tile:nth-child(1) { width:52px;height:52px;background:var(--color-turquoise);top:8%;left:6%;animation-duration:14s;transform:rotate(15deg); }
    .tile:nth-child(2) { width:32px;height:32px;background:var(--color-amber);top:18%;left:18%;animation-duration:18s;animation-delay:-4s;transform:rotate(-10deg); }
    .tile:nth-child(3) { width:68px;height:68px;background:var(--color-coral);top:5%;right:10%;animation-duration:20s;animation-delay:-2s;transform:rotate(30deg); }
    .tile:nth-child(4) { width:40px;height:40px;background:var(--color-emerald);top:30%;right:5%;animation-duration:16s;animation-delay:-8s;transform:rotate(-20deg); }
    .tile:nth-child(5) { width:24px;height:24px;background:var(--color-sapphire);bottom:25%;left:8%;animation-duration:22s;animation-delay:-3s;transform:rotate(45deg); }
    .tile:nth-child(6) { width:56px;height:56px;background:var(--color-amber);bottom:15%;right:12%;animation-duration:17s;animation-delay:-6s;transform:rotate(-35deg); }

    @keyframes float {
      0%   { transform: translateY(0px) rotate(var(--r, 15deg)); }
      50%  { transform: translateY(-18px) rotate(calc(var(--r, 15deg) + 8deg)); }
      100% { transform: translateY(0px) rotate(var(--r, 15deg)); }
    }

    .success-card {
      position: relative;
      background: white;
      border-radius: 24px;
      padding: 56px 48px 48px;
      max-width: 520px;
      width: 100%;
      text-align: center;
      box-shadow: 0 8px 40px rgba(26,58,92,0.10), 0 2px 8px rgba(26,58,92,0.06);
      animation: cardIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes cardIn {
      from { opacity: 0; transform: scale(0.88) translateY(24px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }

    .check-ring {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--color-turquoise) 0%, var(--color-emerald) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 28px;
      box-shadow: 0 0 0 12px rgba(95,184,176,0.15), 0 0 0 24px rgba(95,184,176,0.06);
      animation: ringPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s both;
    }

    @keyframes ringPop {
      from { opacity: 0; transform: scale(0.5); }
      to   { opacity: 1; transform: scale(1); }
    }

    .success-card h1 {
      font-size: 2.4rem;
      color: var(--color-primary);
      margin: 0 0 12px;
      line-height: 1.1;
    }

    .success-card p {
      color: var(--color-text-light);
      font-size: 1.05rem;
      line-height: 1.6;
      margin: 0 0 32px;
    }

    .details-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }

    .detail-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      background: #f5f0ea;
      border-radius: 100px;
      padding: 7px 14px;
      font-size: 0.82rem;
      color: var(--color-primary);
      font-weight: 500;
    }

    .btn-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

    .btn-success-primary {
      background: var(--color-primary);
      color: white;
      padding: 14px 28px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
      transition: background 0.2s, transform 0.15s;
      display: inline-block;
    }
    .btn-success-primary:hover { background: #122a45; transform: translateY(-1px); }

    .btn-success-ghost {
      background: transparent;
      color: var(--color-primary);
      padding: 14px 28px;
      border-radius: 100px;
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 0.06em;
      text-decoration: none;
      text-transform: uppercase;
      border: 2px solid rgba(26,58,92,0.2);
      transition: border-color 0.2s, transform 0.15s;
      display: inline-block;
    }
    .btn-success-ghost:hover { border-color: var(--color-primary); transform: translateY(-1px); }

    .confetti-line { font-size: 1.6rem; margin-bottom: 8px; animation: wiggle 1s ease 0.8s both; }
    @keyframes wiggle {
      0%,100% { transform: rotate(0deg); }
      25% { transform: rotate(-10deg); }
      75% { transform: rotate(10deg); }
    }

    @media (max-width: 560px) {
      .success-wrap { padding: 80px 16px 24px; align-items: flex-start; }
      .success-card { padding: 28px 20px 24px; border-radius: 18px; }
      .check-ring { width: 64px; height: 64px; margin-bottom: 16px; }
      .check-ring svg { width: 28px; height: 28px; }
      .success-card h1 { font-size: 1.7rem; margin-bottom: 8px; }
      .success-card p { font-size: 0.88rem; margin-bottom: 16px; }
      .details-row { gap: 8px; margin-bottom: 14px; }
      .detail-chip { font-size: 0.75rem; padding: 5px 10px; }
      .btn-success-primary, .btn-success-ghost { padding: 12px 20px; font-size: 0.8rem; }
    }
  </style>

  <div class="success-wrap">
    <div class="tile"></div>
    <div class="tile"></div>
    <div class="tile"></div>
    <div class="tile"></div>
    <div class="tile"></div>
    <div class="tile"></div>

    <div class="success-card">
      <div class="confetti-line">🎉</div>
      <div class="check-ring">
        <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>

      <h1>Thank you!</h1>

      <p>
        Your order is confirmed — every piece is handmade and will be packed with care.<br>
        Check your email for your receipt.
      </p>

      <div class="details-row">
        <div class="detail-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M16 2v4M8 2v4M4 10h16"/></svg>
          Receipt sent to your email
        </div>
        <div class="detail-chip">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Ships within a few days
        </div>
      </div>

      <div class="btn-row">
        <a href="/shop" class="btn-success-primary">Back to the Shop</a>
        <a href="/" class="btn-success-ghost">Home</a>
      </div>
    </div>
  </div>

  <script>
    // Order complete — clear the cart
    localStorage.removeItem('pxp_cart');
  </script>
</Base>
