---
import Base from '../../layouts/Base.astro';
import shopData from '../../data/products.json';
import { UNLIMITED_STOCK } from '../../lib/shopStore';

const title = "Checkout — Piece x Piece Mosaics";
const description = "Secure checkout for your handmade mosaic pieces.";

const settings = shopData.settings as any;
const catalog = (shopData.products as any[])
  .map(p => ({
    id: p.id, title: p.title, price: p.price, image: p.image, dimensions: p.dimensions,
    remaining: p.stockMode === 'made_to_order' ? UNLIMITED_STOCK : p.quantity - (p.sold || 0),
  }))
  .filter(p => p.remaining > 0);

const stripePublishableKey = import.meta.env.STRIPE_PUBLISHABLE_KEY ?? '';
---

<Base title={title} description={description}>
  <style>
    .checkout-wrap {
      min-height: 100vh;
      padding: 110px 0 80px;
      background:
        linear-gradient(90deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.92) 100%);
    }
    .checkout-shell {
      max-width: 1080px; margin: 0 auto; padding: 0 24px;
    }
    .checkout-crumbs {
      display: flex; align-items: center; gap: 8px;
      font-size: 0.82rem; color: var(--color-text-light); margin-bottom: 10px;
    }
    .checkout-crumbs a { color: var(--color-turquoise-vibrant); font-weight: 600; }
    .checkout-crumbs a:hover { text-decoration: underline; }
    .checkout-crumbs svg { opacity: 0.5; }
    .checkout-crumbs .current { color: var(--color-primary); font-weight: 600; }
    .checkout-title {
      font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 28px;
    }

    .checkout-cols {
      display: grid; grid-template-columns: 1fr; gap: 28px;
      align-items: start;
    }
    @media (min-width: 900px) {
      .checkout-cols { grid-template-columns: minmax(0, 1fr) 400px; gap: 48px; }
    }

    /* Left: Stripe form */
    .checkout-form {
      background: white; border-radius: 18px;
      box-shadow: 0 6px 32px rgba(26,58,92,0.10);
      padding: 12px; min-height: 420px;
      order: 2;
    }
    @media (min-width: 900px) { .checkout-form { order: 1; } }

    .checkout-loading { padding: 100px 24px; text-align: center; color: var(--color-text-light); font-size: 0.9rem; }
    .checkout-loading .spin {
      width: 32px; height: 32px; border: 2px solid #e0e0e0; border-top-color: var(--color-turquoise-vibrant);
      border-radius: 50%; animation: ckspin .8s linear infinite; margin: 0 auto 16px;
    }
    @keyframes ckspin { to { transform: rotate(360deg); } }
    .checkout-error {
      padding: 60px 32px; text-align: center; color: #b3452f; font-size: 0.95rem; line-height: 1.7;
    }
    .checkout-error a { color: var(--color-turquoise-vibrant); font-weight: 700; text-decoration: underline; }

    /* Right: order summary */
    .order-summary {
      background: #f8f5f0; border: 1px solid rgba(26,58,92,0.10);
      border-radius: 18px; padding: 26px 26px 24px;
      order: 1; position: sticky; top: 96px;
    }
    @media (min-width: 900px) { .order-summary { order: 2; } }

    .order-summary__label {
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--color-text-light); margin-bottom: 18px;
    }
    .summary-item { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .summary-item__thumb { position: relative; flex-shrink: 0; }
    .summary-item__thumb img {
      width: 62px; height: 62px; border-radius: 10px; object-fit: cover;
      border: 1px solid rgba(26,58,92,0.12); background: white;
    }
    .summary-item__qty {
      position: absolute; top: -7px; right: -7px;
      min-width: 21px; height: 21px; padding: 0 5px; border-radius: 100px;
      background: var(--color-primary); color: white;
      font-size: 0.7rem; font-weight: 700;
      display: flex; align-items: center; justify-content: center;
      border: 2px solid #f8f5f0;
    }
    .summary-item__body { flex: 1; min-width: 0; }
    .summary-item__name { font-size: 0.88rem; font-weight: 600; color: var(--color-primary); line-height: 1.3; }
    .summary-item__dims { font-size: 0.76rem; color: var(--color-text-light); margin-top: 1px; }
    .summary-item__amount { font-size: 0.88rem; font-weight: 600; color: var(--color-primary); white-space: nowrap; }

    .summary-divider { height: 1px; background: rgba(26,58,92,0.12); margin: 18px 0; }
    .summary-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: var(--color-text); margin-bottom: 8px; }
    .summary-row .muted { color: var(--color-text-light); }
    .summary-total { display: flex; justify-content: space-between; align-items: baseline; margin-top: 14px; }
    .summary-total .label { font-size: 1.05rem; font-weight: 700; color: var(--color-primary); }
    .summary-total .amount { font-size: 1.35rem; font-weight: 700; color: var(--color-primary); }
    .summary-total .cur { font-size: 0.75rem; font-weight: 600; color: var(--color-text-light); margin-right: 6px; }
    .summary-note { font-size: 0.76rem; color: var(--color-text-light); margin-top: 10px; line-height: 1.6; }
    .summary-edit { font-size: 0.8rem; margin-top: 16px; }
    .summary-edit a { color: var(--color-turquoise-vibrant); font-weight: 600; }
    .summary-edit a:hover { text-decoration: underline; }

    .checkout-empty {
      text-align: center; padding: 80px 24px; background: white;
      border-radius: 18px; box-shadow: 0 6px 32px rgba(26,58,92,0.10);
    }
    .checkout-empty h2 { margin-bottom: 12px; }
    .checkout-empty p { color: var(--color-text-light); margin: 0 auto 28px; }

    .checkout-trust {
      display: flex; gap: 18px; justify-content: center; flex-wrap: wrap;
      margin-top: 22px; font-size: 0.76rem; color: var(--color-text-light);
    }
    .checkout-trust span { display: flex; align-items: center; gap: 6px; }
    .checkout-trust svg { width: 14px; height: 14px; color: var(--color-turquoise-vibrant); }
  </style>

  <div class="checkout-wrap">
    <div class="checkout-shell">

      <div class="checkout-crumbs">
        <a href="/shop">Shop</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        <span>Cart</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
        <span class="current">Checkout</span>
      </div>
      <h1 class="checkout-title">Checkout</h1>

      <!-- Empty cart state -->
      <div class="checkout-empty" id="checkoutEmpty" style="display:none;">
        <h2>Your cart is empty</h2>
        <p>Every piece is handmade and one of a kind — go find the one that's meant for you.</p>
        <a href="/shop" class="btn btn--primary">Browse the Shop</a>
      </div>

      <div class="checkout-cols" id="checkoutCols" style="display:none;">
        <!-- Left: Stripe embedded form -->
        <div class="checkout-form">
          <div class="checkout-loading" id="checkoutLoading">
            <div class="spin"></div>
            Preparing secure checkout…
          </div>
          <div id="checkoutEmbed"></div>
        </div>

        <!-- Right: order summary -->
        <aside class="order-summary" aria-label="Order summary">
          <div class="order-summary__label">Order Summary</div>
          <div id="summaryItems"></div>
          <div class="summary-divider"></div>
          <div class="summary-row"><span>Subtotal</span><span id="summarySubtotal">$0</span></div>
          <div class="summary-row"><span>Shipping</span><span class="muted" id="summaryShipping">Selected at payment</span></div>
          <div class="summary-total">
            <span class="label">Total</span>
            <span class="amount"><span class="cur">USD</span><span id="summaryTotal">$0</span></span>
          </div>
          <div class="summary-note" id="summaryNote"></div>
          <div class="summary-edit"><a href="/shop">← Edit cart or keep shopping</a></div>
        </aside>
      </div>

      <div class="checkout-trust">
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Secure checkout powered by Stripe
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          Carefully packed &amp; shipped
        </span>
        <span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 0C1.46 6.7 1.33 10.28 4 13l8 8 8-8c2.67-2.72 2.54-6.3.42-8.42z"/></svg>
          Handmade in our studio
        </span>
      </div>

    </div>
  </div>

  <script define:vars={{ catalog, stripePublishableKey, flatShippingCents: settings.flatShippingCents, freeShippingThresholdCents: settings.freeShippingThresholdCents }}>
  const CART_KEY = 'pxp_cart';
  const byId = Object.fromEntries(catalog.map(p => [p.id, p]));

  function loadCart() {
    try {
      const raw = JSON.parse(localStorage.getItem(CART_KEY) || '[]');
      return raw
        .filter(i => byId[i.id] && byId[i.id].remaining > 0)
        .map(i => ({ id: i.id, qty: Math.min(Math.max(1, i.qty), byId[i.id].remaining) }));
    } catch { return []; }
  }

  const cart = loadCart();
  const fmt = n => '$' + (Number.isInteger(n) ? n : n.toFixed(2));

  const emptyEl = document.getElementById('checkoutEmpty');
  const colsEl  = document.getElementById('checkoutCols');

  if (cart.length === 0) {
    emptyEl.style.display = '';
  } else {
    colsEl.style.display = '';

    // ── Render order summary ────────────────────────────────────────────────
    const itemsEl = document.getElementById('summaryItems');
    // Inline styles below: this markup is injected via innerHTML, so Astro's scoped
    // <style> classes (.summary-item*) never attach to it — inline is the only way
    // these rules actually apply to dynamically-rendered content.
    itemsEl.innerHTML = cart.map(i => {
      const p = byId[i.id];
      return `
        <div style="display:flex;align-items:center;gap:14px;margin-bottom:16px;">
          <div style="position:relative;flex-shrink:0;">
            <img src="${p.image}" alt="" style="width:62px;height:62px;border-radius:10px;object-fit:cover;border:1px solid rgba(26,58,92,0.12);background:white;display:block;">
            <span title="Quantity" style="position:absolute;top:-7px;right:-7px;min-width:21px;height:21px;padding:0 5px;border-radius:100px;background:var(--color-primary);color:white;font-size:0.7rem;font-weight:700;display:flex;align-items:center;justify-content:center;border:2px solid #f8f5f0;">${i.qty}</span>
          </div>
          <div style="flex:1;min-width:0;">
            <div style="font-size:0.88rem;font-weight:600;color:var(--color-primary);line-height:1.3;">${p.title}</div>
            ${p.dimensions ? `<div style="font-size:0.76rem;color:var(--color-text-light);margin-top:1px;">${p.dimensions}</div>` : ''}
            ${i.qty > 1 ? `<div style="font-size:0.76rem;color:var(--color-text-light);margin-top:1px;">Qty ${i.qty} × ${fmt(p.price)}</div>` : ''}
          </div>
          <div style="font-size:0.88rem;font-weight:600;color:var(--color-primary);white-space:nowrap;">${fmt(p.price * i.qty)}</div>
        </div>`;
    }).join('');

    const subtotal = cart.reduce((s, i) => s + byId[i.id].price * i.qty, 0);
    document.getElementById('summarySubtotal').textContent = fmt(subtotal);

    const freeShip = freeShippingThresholdCents != null && subtotal * 100 >= freeShippingThresholdCents;
    const shippingCost = freeShip ? 0 : flatShippingCents / 100;
    const shipEl = document.getElementById('summaryShipping');
    const noteEl = document.getElementById('summaryNote');
    shipEl.textContent = shippingCost === 0 ? 'Free' : fmt(shippingCost);
    noteEl.textContent = freeShip
      ? 'This order ships free!'
      : `Every order ships — standard shipping is ${fmt(shippingCost)}.`;

    document.getElementById('summaryTotal').textContent = fmt(subtotal + shippingCost);

    // ── Mount Stripe embedded checkout ──────────────────────────────────────
    (async () => {
      const loading = document.getElementById('checkoutLoading');
      try {
        await new Promise((res, rej) => {
          if (window.Stripe) { res(); return; }
          const s = document.createElement('script');
          s.src = 'https://js.stripe.com/v3/';
          s.onload = res; s.onerror = rej;
          document.head.appendChild(s);
        });

        const res = await fetch('/api/shop/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: cart }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to start checkout');

        const stripe = window.Stripe(stripePublishableKey);
        const checkout = await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
        loading.style.display = 'none';
        checkout.mount('#checkoutEmbed');
      } catch (err) {
        loading.outerHTML = `<div style="padding:60px 32px;text-align:center;color:#b3452f;font-size:0.95rem;line-height:1.7;">⚠ ${err.message}<br><a href="/shop" style="color:var(--color-turquoise-vibrant);font-weight:700;text-decoration:underline;">Return to the shop to update your cart</a></div>`;
      }
    })();
  }
  </script>
</Base>
