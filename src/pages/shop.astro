---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import ProductDetailModal from '../components/ProductDetailModal.astro';
import ShopCart from '../components/ShopCart.astro';
import CTABanner from '../components/CTABanner.astro';
import shopData from '../data/products.json';
import { UNLIMITED_STOCK } from '../lib/shopStore';

const title = "Shop Handmade Mosaics — Piece x Piece Mosaics";
const description = "Shop one-of-a-kind handmade mosaics and art pieces, made piece by piece in our studio. Each piece ships carefully packed.";

// Read from products.json — published at deploy time when the client adds/edits an item
const products = (shopData.products as any[]).map(p => ({
  ...p,
  remaining: p.stockMode === 'made_to_order' ? UNLIMITED_STOCK : p.quantity - (p.sold || 0),
}));

// Available pieces first, sold pieces at the end
products.sort((a, b) => (a.remaining <= 0 ? 1 : 0) - (b.remaining <= 0 ? 1 : 0));

const categories = [...new Set(products.map(p => p.category).filter(Boolean))] as string[];

const settings = shopData.settings as any;
const catalog = products
  .filter(p => p.remaining > 0)
  .map(p => ({ id: p.id, title: p.title, price: p.price, image: p.image, remaining: p.remaining, stockMode: p.stockMode }));
---

<Base title={title} description={description}>
  <!-- Page Header -->
  <section class="page-header mosaic-section mosaic-section--light mosaic-clip-1">
    <div class="container fade-in">
      <span class="section__label" style="color: var(--color-primary-dark);">Handmade, Piece by Piece</span>
      <h1>The Shop</h1>
      <p style="color: var(--color-primary-dark);">Original mosaics and art made in our studio. Every piece is one of a kind — once it finds a home, it's gone for good.</p>
    </div>
  </section>

  <div class="mosaic-divider"><span></span><span></span><span></span></div>

  <!-- Product Grid -->
  <section id="shop-items" class="section mosaic-section mosaic-section--emerald mosaic-clip-2" style="padding-top: 40px;">
    <div class="container">
      <div class="section-heading fade-in" style="margin-bottom:0;">
        <span class="section__label">Available Now</span>
        <h2>Original Pieces</h2>
        <p>Each piece ships carefully packed within the US.</p>
      </div>

      {products.length > 0 && (
        <div class="shop-toolbar fade-in">
          {categories.length > 0 ? (
            <div class="shop-filters" role="group" aria-label="Filter by category">
              <button class="shop-filter-chip active" data-filter="all">All</button>
              {categories.map(cat => (
                <button class="shop-filter-chip" data-filter={cat}>{cat}</button>
              ))}
            </div>
          ) : <div></div>}
          <div class="shop-sort">
            <label for="shopSort">Sort</label>
            <select id="shopSort">
              <option value="newest">Newest</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
            </select>
          </div>
        </div>
      )}

      <div class="shop-grid" id="shopGrid">
        {products.length > 0 ? (
          products.map((p: any, index: number) => (
            <ProductCard
              id={p.id}
              title={p.title}
              description={p.description}
              price={p.price}
              imageSrc={p.image}
              images={p.images}
              category={p.category}
              dimensions={p.dimensions}
              badge={p.badge}
              remaining={p.remaining}
              stockMode={p.stockMode}
              index={index}
            />
          ))
        ) : (
          <p style="color:var(--color-text-light);grid-column:1/-1;padding:40px 0;">Nothing in the shop right now — new pieces are always in the works. Check back soon!</p>
        )}
      </div>
      <p class="shop-empty-filter" id="shopEmptyFilter" style="display:none;color:var(--color-text-light);padding:40px 0;text-align:center;">No pieces in this category right now.</p>
    </div>
  </section>

  <div class="mosaic-divider"><span></span><span></span><span></span></div>

  <!-- Commission CTA -->
  <section class="section mosaic-section mosaic-section--sapphire mosaic-clip-3" style="padding-top:40px;padding-bottom:60px;">
    <div class="container">
      <CTABanner
        title="Looking for Something Custom?"
        description="Have an idea for a custom mosaic — a house number, a portrait, a memorial piece? Tell us what you're dreaming of and we'll make it together."
        buttonText="Request a Commission"
        buttonLink="/contact"
      />
    </div>
  </section>

  <ShopCart
    catalog={catalog}
    flatShipping={settings.flatShippingCents / 100}
    freeShippingOver={settings.freeShippingThresholdCents != null ? settings.freeShippingThresholdCents / 100 : null}
  />
  <ProductDetailModal />

  <script>
    // ── Category filter + sort ──────────────────────────────────────────────
    const grid    = document.getElementById('shopGrid')!;
    const chips   = document.querySelectorAll<HTMLButtonElement>('.shop-filter-chip');
    const sortSel = document.getElementById('shopSort') as HTMLSelectElement | null;
    const emptyMsg = document.getElementById('shopEmptyFilter')!;
    const cards   = [...grid.querySelectorAll<HTMLElement>('.shop-card')];
    // Remember publish order for "Newest"
    cards.forEach((c, i) => c.dataset.order = String(i));

    let activeFilter = 'all';

    function apply() {
      // Sort
      const mode = sortSel?.value ?? 'newest';
      const sorted = [...cards].sort((a, b) => {
        if (mode === 'price-asc')  return Number(a.dataset.productPrice) - Number(b.dataset.productPrice);
        if (mode === 'price-desc') return Number(b.dataset.productPrice) - Number(a.dataset.productPrice);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      sorted.forEach(c => grid.appendChild(c));

      // Filter
      let visible = 0;
      cards.forEach(c => {
        const show = activeFilter === 'all' || c.dataset.productCategory === activeFilter;
        c.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      emptyMsg.style.display = visible === 0 ? '' : 'none';
    }

    chips.forEach(chip => chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      activeFilter = chip.dataset.filter ?? 'all';
      apply();
    }));
    sortSel?.addEventListener('change', apply);
  </script>
</Base>
